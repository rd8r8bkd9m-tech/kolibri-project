/* ============================================================================
 * HTTP PARSER
 * ============================================================================ */

typedef struct {
    char method[16];
    char path[2048];
    char body[MAX_REQUEST];
    int body_len;
} HttpRequest;

static int parse_request(const char *raw, HttpRequest *req) {
    /* Method */
    const char *sp = strchr(raw, ' ');
    if (!sp) return -1;
    int mlen = sp - raw;
    if (mlen >= (int)sizeof(req->method)) return -1;
    strncpy(req->method, raw, mlen);
    req->method[mlen] = '\0';

    /* Path */
    const char *path_start = sp + 1;
    const char *path_end = strchr(path_start, ' ');
    if (!path_end) path_end = strchr(path_start, '\r');
    if (!path_end) path_end = strchr(path_start, '\n');
    if (!path_end) return -1;
    int plen = path_end - path_start;
    if (plen >= (int)sizeof(req->path)) return -1;
    strncpy(req->path, path_start, plen);
    req->path[plen] = '\0';

    /* Body */
    const char *body_start = strstr(raw, "\r\n\r\n");
    if (body_start) {
        body_start += 4;
        req->body_len = strlen(body_start);
        if (req->body_len >= MAX_REQUEST) req->body_len = MAX_REQUEST - 1;
        strncpy(req->body, body_start, req->body_len);
        req->body[req->body_len] = '\0';
    } else {
        req->body[0] = '\0';
        req->body_len = 0;
    }

    return 0;
}

/* ============================================================================
 * RESPONSE HELPERS
 * ============================================================================ */

static void send_response(int fd, int status, const char *status_text,
                          const char *content_type, const char *body, int body_len) {
    char header[512];
    int hlen = snprintf(header, sizeof(header),
        "HTTP/1.1 %d %s\r\n"
        "Content-Type: %s\r\n"
        "Content-Length: %d\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
        "Access-Control-Allow-Headers: Content-Type, Authorization\r\n"
        "\r\n",
        status, status_text, content_type, body_len);
    write(fd, header, hlen);
    if (body && body_len > 0) write(fd, body, body_len);
}

static void send_json(int fd, int status, const char *status_text, const char *json) {
    send_response(fd, status, status_text, "application/json", json, strlen(json));
}

static void send_file(int fd, const char *path) {
    FILE *f = fopen(path, "rb");
    if (!f) {
        const char *not_found = "{\"error\":\"not found\"}";
        send_json(fd, 404, "Not Found", not_found);
        return;
    }

    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);

    /* Content type */
    const char *ct = "application/octet-stream";
    if (strstr(path, ".html")) ct = "text/html";
    else if (strstr(path, ".js")) ct = "application/javascript";
    else if (strstr(path, ".css")) ct = "text/css";
    else if (strstr(path, ".wasm")) ct = "application/wasm";
    else if (strstr(path, ".json")) ct = "application/json";
    else if (strstr(path, ".png")) ct = "image/png";
    else if (strstr(path, ".svg")) ct = "image/svg+xml";
    else if (strstr(path, ".ico")) ct = "image/x-icon";

    char header[512];
    int hlen = snprintf(header, sizeof(header),
        "HTTP/1.1 200 OK\r\n"
        "Content-Type: %s\r\n"
        "Content-Length: %ld\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "\r\n", ct, size);
    write(fd, header, hlen);

    char buf[8192];
    size_t n;
    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
        write(fd, buf, n);
    }
    fclose(f);
}

/* ============================================================================
 * JSON HELPERS
 * ============================================================================ */

static int json_get_dbl(const char *json, const char *key, double *out) {
    char search[256];
    snprintf(search, sizeof(search), "\"%s\":", key);
    const char *p = strstr(json, search);
    if (!p) return -1;
    p += strlen(search);
    while (*p == ' ') p++;
    *out = atof(p);
    return 0;
}

static int json_get_str(const char *json, const char *key, char *out, int out_size) {
    char search[512];
    snprintf(search, sizeof(search), "\"%s\":\"", key);
    const char *p = strstr(json, search);
    if (!p) return -1;
    p += strlen(search);
    int i = 0;
    while (*p && *p != '"' && i < out_size - 1) out[i++] = *p++;
    out[i] = '\0';
    return i > 0 ? 0 : -1;
}

static void json_escape(char *out, const char *in, int out_size) {
    int j = 0;
    for (int i = 0; in[i] && j < out_size - 3; i++) {
        if (in[i] == '"' || in[i] == '\\') { out[j++] = '\\'; }
        out[j++] = in[i];
    }
    out[j] = '\0';
}

/* ============================================================================
 * API HANDLERS
 * ============================================================================ */

static void handle_reason(int fd, const char *body) {
    char query[1024];
    if (json_get_str(body, "query", query, sizeof(query)) != 0) {
        send_json(fd, 400, "Bad Request", "{\"error\":\"missing query\"}");
        return;
    }

    KolibriReasoningResult result;
    int ret = kolibri_re_reason(query, &g_re_config, &result, NULL, NULL);
    if (ret != 0) {
        char err[256];
        snprintf(err, sizeof(err), "{\"error\":\"reasoning failed\",\"code\":%d}", ret);
        send_json(fd, 500, "Internal Error", err);
        return;
    }

    char safe[2048];
    json_escape(safe, result.answer, sizeof(safe));

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"answer\":\"%s\",\"type\":\"%s\",\"confidence\":%.4f,\"steps\":%d,\"time_ms\":%.1f}",
        safe, kolibri_re_type_name(result.primary_type),
        result.confidence, result.chain.num_steps, result.reasoning_time_ms);
    send_json(fd, 200, "OK", resp);
}

static void handle_solve_linear(int fd, const char *body) {
    double a = 0, b = 0, c = 0;
    json_get_dbl(body, "a", &a);
    json_get_dbl(body, "b", &b);
    json_get_dbl(body, "c", &c);

    KolibriEquationSolution sol;
    int ret = kolibri_solve_linear(a, b, c, &sol);
    if (ret != 0) {
        send_json(fd, 500, "Internal Error", "{\"error\":\"solve failed\"}");
        return;
    }

    const char *type_str = (sol.sol_type == KMS_SOL_ONE) ? "one" :
                           (sol.sol_type == KMS_SOL_NONE) ? "none" : "infinite";

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"type\":\"%s\",\"x\":%.10f,\"steps\":%d}",
        type_str, sol.sol_type == KMS_SOL_ONE ? sol.x1 : 0.0, sol.num_steps);
    send_json(fd, 200, "OK", resp);
}

static void handle_solve_quadratic(int fd, const char *body) {
    double a = 0, b = 0, c = 0;
    json_get_dbl(body, "a", &a);
    json_get_dbl(body, "b", &b);
    json_get_dbl(body, "c", &c);

    KolibriEquationSolution sol;
    int ret = kolibri_solve_quadratic(a, b, c, &sol);
    if (ret != 0) {
        send_json(fd, 500, "Internal Error", "{\"error\":\"solve failed\"}");
        return;
    }

    const char *type_str = (sol.sol_type == KMS_SOL_TWO) ? "two" :
                           (sol.sol_type == KMS_SOL_ONE) ? "one" : "complex";

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"type\":\"%s\",\"x1\":%.10f,\"x2\":%.10f,\"discriminant\":%.10f,\"steps\":%d}",
        type_str, sol.x1, sol.x2, sol.discriminant, sol.num_steps);
    send_json(fd, 200, "OK", resp);
}

static void handle_tokenize(int fd, const char *body) {
    char expr[1024];
    if (json_get_str(body, "expression", expr, sizeof(expr)) != 0) {
        send_json(fd, 400, "Bad Request", "{\"error\":\"missing expression\"}");
        return;
    }

    KolibriTokenizer tokenizer;
    kolibri_tokenizer_init(&tokenizer);

    KolibriTokenizationResult result;
    int ret = kolibri_tokenize_math(&tokenizer, expr, &result);
    kolibri_tokenizer_free(&tokenizer);

    if (ret != 0) {
        send_json(fd, 500, "Internal Error", "{\"error\":\"tokenize failed\"}");
        return;
    }

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"token_count\":%d,\"numbers\":%d,\"operators\":%d,\"functions\":%d}",
        result.token_count, result.num_count, result.operator_count, result.function_count);
    send_json(fd, 200, "OK", resp);
}

static void handle_verify(int fd, const char *body) {
    char query[1024], answer[1024];
    if (json_get_str(body, "query", query, sizeof(query)) != 0 ||
        json_get_str(body, "answer", answer, sizeof(answer)) != 0) {
        send_json(fd, 400, "Bad Request", "{\"error\":\"missing query/answer\"}");
        return;
    }

    KolibriSVConfig sv_config = {0};
    sv_config.enable_formula_check = 1;
    sv_config.enable_logical_check = 1;
    sv_config.enable_knowledge_check = 1;
    sv_config.enable_arithmetic_check = 1;

    KolibriSVReport report;
    int ret = kolibri_sv_verify_answer(query, answer, &sv_config, &report, NULL, NULL);
    if (ret != 0) {
        send_json(fd, 500, "Internal Error", "{\"error\":\"verify failed\"}");
        return;
    }

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"agreement\":%d,\"confidence\":%.4f,\"contradictions\":%d,\"methods\":%d}",
        report.agreement, report.final_confidence,
        report.num_contradictions, report.num_methods_used);
    send_json(fd, 200, "OK", resp);
}

static void handle_explain(int fd, const char *body) {
    char query[1024];
    if (json_get_str(body, "query", query, sizeof(query)) != 0) {
        send_json(fd, 400, "Bad Request", "{\"error\":\"missing query\"}");
        return;
    }

    KolibriReasoningResult result;
    kolibri_re_reason(query, &g_re_config, &result, NULL, NULL);

    char safe[4096];
    json_escape(safe, result.answer, sizeof(safe));

    char resp[MAX_RESPONSE];
    snprintf(resp, sizeof(resp),
        "{\"explanation\":\"%s\",\"type\":\"%s\",\"confidence\":%.4f,\"steps\":%d}",
        safe, kolibri_re_type_name(result.primary_type),
        result.confidence, result.chain.num_steps);
    send_json(fd, 200, "OK", resp);
}

