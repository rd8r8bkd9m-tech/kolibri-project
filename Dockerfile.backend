FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir uvicorn fastapi httpx asyncpg pydantic

COPY backend backend/
COPY backend/service backend/service/

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.service.main:app", "--host", "0.0.0.0", "--port", "8000"]
